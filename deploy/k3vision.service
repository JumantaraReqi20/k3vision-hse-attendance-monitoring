[Unit]
Description=K3Vision FastAPI service
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/k3vision
EnvironmentFile=/var/www/k3vision/.env
Environment="PATH=/var/www/k3vision/venv/bin"
ExecStart=/var/www/k3vision/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
